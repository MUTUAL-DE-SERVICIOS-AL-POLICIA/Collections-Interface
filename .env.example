# URL interna del Gateway, alcanzable desde el contenedor frontend
GATEWAY_INTERNAL_URL=http://gateway.example.test:3000

# Origen público del Hub, disponible solo en el servidor
HUB_PUBLIC_ORIGIN=http://hub.example.test

# Clave de herramienta registrada en el catálogo de Auth, solo servidor
AUTH_TOOL_KEY=collections

# DEPLOY ENV prod | dev | test
NEXT_PUBLIC_DEPLOY_ENV=prod
